.container {
  padding-bottom: 60rpx;
}

/* 品牌+结果合并头部 */
.brand-logo-clip {
  overflow: hidden;
  height: 178rpx;
}

.brand-banner {
  width: 100%;
  display: block;
}

/* 结果头部 */
.result-header {
  background: linear-gradient(135deg, #3370ff, #2b5fd9);
  color: #ffffff;
}

.result-header-body {
  padding: 24rpx 40rpx 48rpx;
}

.result-header-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.result-header-city {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 核心指标卡片 */
.metrics-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: -24rpx 32rpx 24rpx;
  padding: 40rpx 16rpx 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  box-shadow: 0 8rpx 32rpx rgba(51, 112, 255, 0.12);
  position: relative;
  z-index: 1;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

/* 指标图标 */
.metric-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.icon-payback {
  background: #fff8ed;
}

.icon-roi {
  background: #eef3ff;
}

.icon-profit {
  background: #edfbf2;
}

/* 指标数值 - 各自颜色 */
.metric-value {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
}

.value-payback {
  color: #ff9500;
}

.value-roi {
  color: #3370ff;
}

.value-profit {
  color: #34c759;
}

.metric-negative {
  color: #f54a45 !important;
  font-size: 28rpx;
}

.metric-unit {
  font-size: 22rpx;
  color: #8f959e;
  margin-top: 4rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #646a73;
  margin-top: 12rpx;
  font-weight: 500;
}

.metric-divider {
  width: 2rpx;
  height: 80rpx;
  background: #f0f1f2;
  margin-top: 48rpx;
}

/* 详细数据行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f6f7;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row.highlight {
  padding-top: 24rpx;
  margin-top: 8rpx;
  border-top: 2rpx dashed #e0e3e8;
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #646a73;
}

.detail-value {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.detail-value.cost {
  color: #f54a45;
}

.detail-value.profit {
  color: #34c759;
  font-weight: 600;
}

.detail-value.loss {
  color: #f54a45;
  font-weight: 600;
}

/* 成本结构条形图 */
.cost-bar-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cost-bar-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cost-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cost-bar-name {
  font-size: 24rpx;
  color: #646a73;
}

.cost-bar-percent {
  font-size: 24rpx;
  color: #1f2329;
  font-weight: 500;
}

.cost-bar-track {
  height: 16rpx;
  background: #f5f6f7;
  border-radius: 8rpx;
  overflow: hidden;
}

.cost-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

/* 成本合计行 */
.cost-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e0e3e8;
}

.cost-total-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.cost-total-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #3370ff;
}

/* 投资评估 */
.assessment {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.assessment-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.assessment-icon.level-good {
  background: #e8f8ee;
  color: #34c759;
}

.assessment-icon.level-medium {
  background: #fff8e6;
  color: #ff9500;
}

.assessment-icon.level-poor {
  background: #ffedec;
  color: #f54a45;
}

.assessment-content {
  flex: 1;
}

.assessment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 8rpx;
}

.assessment-desc {
  font-size: 26rpx;
  color: #646a73;
  line-height: 1.6;
}

/* 按钮 */
.btn-wrapper {
  padding: 20rpx 32rpx;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: #3370ff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  border: 2rpx solid #3370ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: #f0f5ff;
}

/* 按钮区声明文字 */
.btn-disclaimer {
  font-size: 22rpx;
  color: #3370ff;
  text-align: center;
  line-height: 1.6;
  margin-top: 16rpx;
  padding: 0 20rpx;
}

/* 意见反馈 */
.feedback-card {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.feedback-expanded {
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* 折叠态提示条 */
.feedback-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.feedback-prompt-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feedback-prompt-emoji {
  font-size: 36rpx;
}

.feedback-prompt-text {
  font-size: 28rpx;
  color: #646a73;
}

.feedback-prompt-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #c0c4cc;
  border-right: 4rpx solid #c0c4cc;
  transform: rotate(45deg);
}

/* 展开态头部 */
.feedback-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 0;
}

.feedback-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.feedback-title-emoji {
  font-size: 36rpx;
}

.feedback-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.feedback-close {
  font-size: 26rpx;
  color: #8f959e;
  padding: 4rpx 0;
}

/* 表单区域 */
.feedback-body {
  padding: 24rpx 32rpx;
}

.feedback-section {
  margin-bottom: 28rpx;
}

.feedback-section:last-child {
  margin-bottom: 0;
}

.feedback-label {
  font-size: 26rpx;
  color: #646a73;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 文本域 */
.feedback-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
  box-sizing: border-box;
}

.feedback-count {
  text-align: right;
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 8rpx;
}

/* 图片上传 */
.feedback-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.feedback-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.feedback-image-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.feedback-image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.feedback-image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #d0d3d9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.feedback-image-add-icon {
  font-size: 48rpx;
  color: #c0c4cc;
  line-height: 1;
}

.feedback-image-add-text {
  font-size: 20rpx;
  color: #c0c4cc;
}

.feedback-hint {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 8rpx;
}

/* 联系方式输入 */
.feedback-contact-input {
  width: 100%;
  height: 80rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2329;
  box-sizing: border-box;
}

.feedback-contact-error {
  font-size: 22rpx;
  color: #f54a45;
  margin-top: 8rpx;
}

/* 提交按钮 */
.feedback-actions {
  padding: 0 32rpx 28rpx;
}

.feedback-submit-btn {
  width: 100%;
  height: 88rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
}

.feedback-submit-btn::after {
  border: none;
}

.feedback-submit-btn[disabled] {
  background: #c0c4cc;
  color: #ffffff;
}

.feedback-submit-btn:active:not([disabled]) {
  background: #2b5fd9;
}

/* 提交成功 */
.feedback-success {
  margin: 0 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feedback-success-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8f8ee;
  color: #34c759;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feedback-success-text {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.5;
}

/* 底部安全区 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
