.container {
  padding-bottom: 60rpx;
}

/* 城市输入带建议列表 */
.city-input-wrapper {
  position: relative;
}

.city-suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: 130rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  max-height: 400rpx;
  overflow-y: auto;
}

.city-suggestion-item {
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1f2329;
  border-bottom: 1rpx solid #f5f6f7;
}

.city-suggestion-item:last-child {
  border-bottom: none;
}

.city-suggestion-item:active {
  background: #f0f5ff;
}

/* 品牌头部区域 */
.brand-header {
  background: #ffffff;
  padding-bottom: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 裁剪容器：隐藏图片底部的功能特性区 */
.brand-logo-clip {
  overflow: hidden;
  /* 图片全宽渲染约 273rpx 高，logo+slogan 占上方约 65%，取 178rpx */
  height: 178rpx;
}

.brand-banner {
  width: 100%;
  display: block;
}

/* 标签选择组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 业态宫格 */
.bt-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.bt-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  background: #f5f6f7;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.18s;
}

.bt-grid-item:active {
  transform: scale(0.94);
  background: #eef0f3;
}

.bt-grid-active {
  background: #e8f0ff;
  border-color: #3370ff;
}

.bt-grid-icon {
  font-size: 40rpx;
  line-height: 1;
}

.bt-grid-name {
  font-size: 22rpx;
  color: #646a73;
  font-weight: 500;
  text-align: center;
}

.bt-grid-active .bt-grid-name {
  color: #3370ff;
}

/* 业态输入带建议列表（保留供搜索备用，已隐藏） */
.bt-input-wrapper {
  position: relative;
}

.bt-suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: 130rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  max-height: 480rpx;
  overflow-y: auto;
}

.bt-suggestion-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.bt-suggestion-item:last-child {
  border-bottom: none;
}

.bt-suggestion-item:active {
  background: #f0f5ff;
}

.bt-suggestion-name {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.bt-suggestion-sub {
  font-size: 22rpx;
  color: #8f959e;
  margin-top: 4rpx;
}

.tag-item {
  padding: 14rpx 28rpx;
  background: #f5f6f7;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #646a73;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-active {
  background: #e8f0ff;
  color: #3370ff;
  border-color: #3370ff;
  font-weight: 500;
}

/* 信息提示 */
.info-tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  border-left: 4rpx solid #3370ff;
}

.tip-row {
  margin-bottom: 8rpx;
  display: flex;
  font-size: 24rpx;
}

.tip-row:last-child {
  margin-bottom: 0;
}

.tip-label {
  color: #8f959e;
  white-space: nowrap;
}

.tip-value {
  color: #1f2329;
  flex: 1;
}

/* 单选组 */
.radio-group-custom {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: #f5f6f7;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.radio-active {
  background: #e8f0ff;
  border-color: #3370ff;
}

.radio-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #c9cdd4;
  margin-right: 20rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: all 0.2s;
}

.dot-active {
  border-color: #3370ff;
  background: #3370ff;
  box-shadow: inset 0 0 0 4rpx #ffffff;
}

.radio-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.radio-label {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}

.radio-desc {
  font-size: 24rpx;
  color: #8f959e;
  margin-top: 4rpx;
}

/* 子选项区域 */
.sub-options {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f1f2;
}

.sub-title {
  font-size: 26rpx;
  color: #646a73;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.sub-title-hint {
  font-size: 22rpx;
  color: #3370ff;
  font-weight: 400;
}

/* 直营/合伙模式提示 */
.mode-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #f0f5ff;
  border-radius: 10rpx;
}

.mode-hint-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #3370ff;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mode-hint-text {
  font-size: 26rpx;
  color: #3370ff;
}

/* 选项列表样式 */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.option-list-item {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #f5f6f7;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-list-item:active {
  background: #eef0f3;
}

.option-active {
  background: #e8f0ff;
  border-color: #3370ff;
}

.option-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #c9cdd4;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #ffffff;
  box-sizing: border-box;
  transition: all 0.2s;
}

.check-active {
  background: #3370ff;
  border-color: #3370ff;
}

.option-text {
  font-size: 27rpx;
  color: #1f2329;
}

.option-active .option-text {
  color: #3370ff;
  font-weight: 500;
}

/* 动态输入区 */
.dynamic-inputs {
  margin-top: 16rpx;
}

/* 成本结构卡片 */
.card-title-hint {
  font-size: 22rpx;
  color: #8f959e;
  font-weight: 400;
  margin-left: 8rpx;
}

.cost-reset-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: #fff8e6;
  border-radius: 8rpx;
}

.cost-reset-text {
  font-size: 24rpx;
  color: #ff9500;
}

.cost-reset-btn {
  font-size: 24rpx;
  color: #3370ff;
  font-weight: 500;
}

.cost-item {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f6f7;
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cost-item-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.cost-item-label {
  font-size: 26rpx;
  color: #646a73;
}

.cost-item-range {
  font-size: 22rpx;
  color: #b2b8c0;
  margin-top: 6rpx;
}

/* 给值超出参考区间时高亮 */
.range-warning {
  color: #ff9500;
}

.cost-item-input-wrap {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.cost-item-input {
  width: 120rpx;
  height: 52rpx;
  background: #f5f6f7;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1f2329;
  font-weight: 500;
}

.cost-item-unit {
  font-size: 24rpx;
  color: #8f959e;
}

.cost-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 2rpx dashed #e0e3e8;
}

.cost-total-label {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}

.cost-total-value {
  font-size: 28rpx;
  color: #34c759;
  font-weight: 600;
}

.cost-total-warning {
  color: #f54a45;
}

/* 按钮容器 */
.btn-wrapper {
  padding: 20rpx 32rpx;
}

.btn-disclaimer {
  font-size: 22rpx;
  color: #3370ff;
  text-align: center;
  line-height: 1.6;
  margin-top: 16rpx;
  padding: 0 20rpx;
}

/* 底部安全区 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
